    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header class="top-header">
        <div class="header-container">
            <div class="header-left">
                <span>WELCOME TO INVESTORS PLANET REALTY</span>
            </div>
            <div class="header-right">
                <a href="tel:+919555891638"><i class="bi bi-telephone-fill"></i> +91 95558 91638</a>
                <a href="mailto:info@investorsplanet.co.in"><i class="bi bi-envelope-fill"></i>
                    info@investorsplanet.co.in</a>
            </div>
        </div>
    </header>

    <nav class="custom-navbar">
        <div class="nav-container">

            <a href="#" class="brand-box">
                <img src="images/logo.webp" alt="Logo" class="site-logo">
            </a>

            <button class="nav-toggle-btn" id="openMenu">
                <i class="bi bi-list"></i>
            </button>

            <div class="desktop-menu">
                <ul class="nav-links">
                    <li><a href="#" class="active">Home</a></li>
                    <li><a href="#">About</a></li>
                    <li><a href="#">Properties</a></li>
                    <li><a href="#">Projects</a></li>
                    <li><a href="#">Investors</a></li>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Contact</a></li>
                </ul>

                <div class="nav-actions">
                    <a href="#" class="social-btn"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="social-btn"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="social-btn"><i class="fa-brands fa-x-twitter"></i></a>
                    <a href="#reach" class="enquire-btn">Enquire Now </a>
                </div>
            </div>

        </div>
    </nav>

    <div class="side-overlay" id="sideOverlay"></div>

    <div class="side-drawer" id="sideDrawer">
        <div class="drawer-top">
            <h4>Menu</h4>
            <button id="closeMenu"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="drawer-links">
            <a href="#" class="active">Home</a>
            <a href="#">About</a>
            <a href="#">Properties</a>
            <a href="#">Projects</a>
            <a href="#">Investors</a>
            <a href="#">Blog</a>
            <a href="#">Contact</a>
        </div>

        <div class="drawer-bottom">
            <div class="drawer-socials">
                <a href="#" class="social-btn"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="#" class="social-btn"><i class="fa-brands fa-instagram"></i></a>
                <a href="#" class="social-btn"><i class="fa-brands fa-x-twitter"></i></a>
            </div>
            <a href="#reach" class="enquire-btn drawer-enquire">Enquire Now &rarr;</a>
        </div>
    </div>

<!-- new  -->

<!-- new  -->
 <footer class="main-footer-section">
  <div class="footer-container">
    
    <div class="footer-top-grid">
      
      <div class="footer-col brand-col">
        <div class="footer-brand-wrap">
          <img src="logo.png" alt="Logo" class="footer-logo">
          <div class="footer-brand-text">
            <h3>BHUTANI</h3>
            <span>BUILDING BETTER TOMORROW</span>
          </div>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-col-title">Quick Links</h4>
        <ul class="footer-links-list">
          <li><a href="#">Home</a></li>
          <li><a href="#">About Us</a></li>
          <li><a href="#">Properties</a></li>
          <li><a href="#">Projects</a></li>
          <li><a href="#">Investors</a></li>
          <li><a href="#">Blogs</a></li>
          <li><a href="#">Contact</a></li>
        </ul>
      </div>

      <div class="footer-col contact-col">
        <h4 class="footer-col-title">Contact Info</h4>
        <div class="contact-item">
          <i class="bi bi-geo-alt"></i>
          <span>Bhutani Group, Sector 62, Noida,<br>Uttar Pradesh, India</span>
        </div>
        <div class="contact-item">
          <i class="bi bi-telephone"></i>
          <a href="tel:+911201234567">+91 120 123 4567</a>
        </div>
        <div class="contact-item">
          <i class="bi bi-envelope"></i>
          <a href="mailto:info@bhutani.com">info@bhutani.com</a>
        </div>

        <div class="footer-social-icons">
          <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
          <a href="#"><i class="fa-brands fa-instagram"></i></a>
          <a href="#"><i class="fa-brands fa-youtube"></i></a>
          <a href="#"><i class="fa-brands fa-facebook-f"></i></a>
          <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
        </div>
      </div>

      <div class="footer-col newsletter-col">
        <h4 class="footer-col-title">Newsletter</h4>
        <p class="newsletter-text">
          Stay updated with our latest projects and news.
        </p>

        <form class="newsletter-form">
          <input type="email" placeholder="Enter your email" required>
          <button type="submit">
            <i class="bi bi-arrow-right"></i>
          </button>
        </form>
      </div>

    </div>

    <div class="footer-bottom-bar">
      <div class="copyright-text">
        © 2024 Bhutani Group. All Rights Reserved.
      </div>

      <div class="legal-links">
        <a href="#">Privacy Policy</a>
        <span class="divider">|</span>
        <a href="#">Terms & Conditions</a>
        <span class="divider">|</span>
        <a href="#">Sitemap</a>
      </div>

      <div class="tagline-text">
        Designed for a Better Tomorrow.
      </div>
    </div>

  </div>
</footer>
